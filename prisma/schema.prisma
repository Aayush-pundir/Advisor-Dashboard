// Advisor Dashboard — data model for the OmniCard CA Partner Network program
// Maps directly to the 10-step execution plan (see /docs/ARCHITECTURE.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  partnerId    String?
  partner      Partner? @relation(fields: [partnerId], references: [id])
  firmRole     String   @default("OWNER") // OWNER | MEMBER — multiple users can share a Partner (firm)

  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime?
  sessionVersion     Int       @default(1) // bump to invalidate all issued sessions ("sign out everywhere")
  lastLoginAt        DateTime?
  active             Boolean   @default(true)

  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  createdAt DateTime @default(now())

  passwordResetTokens PasswordResetToken[]
  auditLogEntries     AuditLog[]
  notifications       Notification[]
  assignedLeads       Lead[]               @relation("AssignedSalesRep")
  supportTickets      SupportTicket[]

  @@index([partnerId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Login attempts for basic rate-limiting / lockout.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// In-app notification feed — surfaces milestones, leads, commissions, campaigns.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, readAt])
}

// Who did what, for internal ops accountability.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorName  String
  action     String
  targetType String
  targetId   String?
  meta       String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Partner (CA) lifecycle — Steps 1, 4, 5
// ---------------------------------------------------------------------------

model Partner {
  id          String @id @default(cuid())
  slug        String @unique // omnicard.in/advisor/[firm]
  firmName    String
  contactName String
  email       String @unique
  phone       String
  city        String
  state       String

  icaiNumber   String?
  icaiVerified Boolean   @default(false)
  msaSignedAt  DateTime?
  designation  String? // signatory designation captured on the MOU

  stage              String    @default("LEAD")
  acceptedAt         DateTime? // admin accepted the lead & scheduled an intro call
  mouCountersignedAt DateTime? // OmniCard team countersigned the MOU
  demoRequestedAt    DateTime? // partner requested a demo/training slot
  certifiedAt        DateTime?
  demoScheduledAt    DateTime?
  demoAttendedAt     DateTime?

  // ICP scoring — Step 1.2 (100 pts total)
  icpClients  Int @default(0) // /25
  icpAdvisory Int @default(0) // /20
  icpTech     Int @default(0) // /15
  icpSize     Int @default(0) // /10
  icpGeo      Int @default(0) // /10
  icpDigital  Int @default(0) // /10
  icpMindset  Int @default(0) // /10

  badgeTier     String    @default("NONE")
  tierUpdatedAt DateTime?
  certLevel     String    @default("NONE") // NONE | DEMO | PRODUCT | SALES — Step-up certification track
  referralCode  String    @unique
  mouVersion    String    @default("v1")

  // Payout details — Phase 1 advisor account layer
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?
  pan               String?
  gstNumber         String?

  referredById String?
  referredBy   Partner?  @relation("PartnerReferrals", fields: [referredById], references: [id])
  referrals    Partner[] @relation("PartnerReferrals")

  // Integrations — partner-facing API key + outbound webhook on lead closed
  apiKey        String? @unique
  webhookUrl    String?
  webhookSecret String?

  users                 User[]
  assetKitItems         AssetKitItem[]
  leads                 Lead[]
  commissions           Commission[]
  campaigns             Campaign[]
  badges                Badge[]
  activities            ActivityEvent[]
  referralBonusesEarned ReferralBonus[]         @relation("ReferrerBonuses")
  referralBonusesFor    ReferralBonus[]         @relation("ReferredBonuses")
  supportTickets        SupportTicket[]
  certifications        CertificationProgress[]
  marketingContacts     MarketingContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([city])
}

// icpTotal is computed in application code (sum of the seven fields);
// scores >=70 are pursued, <50 are skipped per Step 1.2.

// ---------------------------------------------------------------------------
// Per-CA creation checklist — Step 3 (12 deliverables, tracked as checkboxes)
// ---------------------------------------------------------------------------

model AssetKitItem {
  id          String    @id @default(cuid())
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  key         String
  status      String    @default("PENDING")
  owner       String // e.g. "Marketing Ops", "Auto (CRM)", "Design"
  dueAt       DateTime?
  deliveredAt DateTime?

  @@unique([partnerId, key])
}

// ---------------------------------------------------------------------------
// Lead-to-Revenue machine — Step 6
// ---------------------------------------------------------------------------

model Lead {
  id           String       @id @default(cuid())
  partnerId    String
  partner      Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  businessName String
  contactName  String
  phone        String
  email        String
  source       String
  stage        String       @default("CAPTURED")
  dealValue    Int          @default(0) // annual contract value, INR
  contactedAt  DateTime?
  demoAt       DateTime?
  closedAt     DateTime?
  commissions  Commission[]
  createdAt    DateTime     @default(now())

  assignedToId String?
  assignedTo   User?   @relation("AssignedSalesRep", fields: [assignedToId], references: [id])

  // Post-sale client health (Task: health score + churn risk)
  healthScore        Int? // 0-100, computed
  riskLevel          String    @default("LOW") // LOW | MEDIUM | HIGH
  npsScore           Int?
  supportTicketCount Int       @default(0)
  lastActivityAt     DateTime?

  @@index([partnerId])
  @@index([stage])
  @@index([assignedToId])
}

// ---------------------------------------------------------------------------
// Co-branded marketing contact list — a partner's full client roster,
// uploaded purely for masked campaign targeting. Deliberately NOT the same
// model as Lead: no pipeline stage, no deal value, no commission — this is
// a contact list, not a sales pipeline.
// ---------------------------------------------------------------------------

model MarketingContact {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  contactName String
  phone       String
  email       String?
  city        String?
  createdAt   DateTime @default(now())

  @@index([partnerId])
}

// ---------------------------------------------------------------------------
// Commission ledger — Step 1.4 / Step 6.6 / Step 10 unit economics
// ---------------------------------------------------------------------------

model Commission {
  id         String    @id @default(cuid())
  partnerId  String
  partner    Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  type       String
  amount     Int // INR
  status     String    @default("PENDING")
  creditedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([partnerId])
}

model ReferralBonus {
  id         String   @id @default(cuid())
  referrerId String
  referrer   Partner  @relation("ReferrerBonuses", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId String
  referred   Partner  @relation("ReferredBonuses", fields: [referredId], references: [id], onDelete: Cascade)
  amount     Int
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Milestones & badges — Step 4
// ---------------------------------------------------------------------------

model Badge {
  id                 String    @id @default(cuid())
  partnerId          String
  partner            Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tier               String
  quarter            String // e.g. "2026-Q3"
  clientsAtMilestone Int
  issuedAt           DateTime  @default(now())
  giftDispatchedAt   DateTime?

  @@unique([partnerId, quarter, tier])
}

// ---------------------------------------------------------------------------
// Acquisition marketing engine — Step 7 + campaign approvals
// ---------------------------------------------------------------------------

model Campaign {
  id          String    @id @default(cuid())
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type        String
  title       String
  status      String    @default("DRAFTED")
  scheduledAt DateTime?
  approvedAt  DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([partnerId])
}

// ---------------------------------------------------------------------------
// Activity tracking — Step 6.1 / Step 9 attribution
// ---------------------------------------------------------------------------

model ActivityEvent {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type      String
  meta      String?
  createdAt DateTime @default(now())

  @@index([partnerId])
  @@index([type])
}

// ---------------------------------------------------------------------------
// KPI snapshots — Step 9, weekly cadence
// ---------------------------------------------------------------------------

model KpiSnapshot {
  id                          String   @id @default(cuid())
  weekOf                      DateTime @unique
  costPerPartnerLead          Int // target <= 500
  visitorToSignupPct          Float // target >= 8
  signupToCertifiedPct        Float // target >= 70
  avgDaysToCertify            Float // target <= 7
  certifiedToFirstCampaignPct Float // target >= 60 (activation kill metric)
  leadToDemoPct               Float // target >= 40
  demoToClosePct              Float // target >= 25
  slaPct                      Float // target >= 95
  clientsPerActiveCA          Float // target >= 5
  nps                         Float // target >= 50
  dormancyPct                 Float // target < 25
  referredSharePct            Float // target >= 20
  createdAt                   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Support & escalation
// ---------------------------------------------------------------------------

model SupportTicket {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerId       String?
  partner         Partner?  @relation(fields: [partnerId], references: [id])
  subject         String
  message         String
  status          String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | ESCALATED
  priority        String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  escalationLevel Int       @default(1) // 1=Partner Success, 2=Partner Manager, 3=Regional Head, 4=Leadership
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([userId])
  @@index([partnerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Certification / LMS progress — Step-up track beyond "one demo = certified"
// ---------------------------------------------------------------------------

model CertificationProgress {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  moduleKey   String
  completedAt DateTime @default(now())

  @@unique([partnerId, moduleKey])
}
